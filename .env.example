# Copy to .env only after replacing all production secrets.
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin-demo-change-me
DEMO_COUNSELLOR_USERNAME=counsellor
DEMO_COUNSELLOR_PASSWORD=counsellor-demo-change-me

# Optional AI; disabled unless explicitly configured.
AI_PROVIDER=disabled
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=700
AI_TIMEOUT_SECONDS=20

# For production set DEMO_MODE=false and AUTO_CREATE_SCHEMA=false, then create
# staff accounts interactively with `python -m app.manage_users add-user`.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/aajeevika
# AUTH_COOKIE_SECURE=true
