# Copy to .env only after replacing all production secrets.
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin-demo-change-me
DEMO_COUNSELLOR_USERNAME=counsellor
DEMO_COUNSELLOR_PASSWORD=counsellor-demo-change-me
FOLLOWUP_INTERVAL_DAYS=7,30,90

# Optional AI; disabled unless explicitly configured.
AI_PROVIDER=disabled
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=700
AI_TIMEOUT_SECONDS=20

# Knowledge retrieval defaults preserve portable SQLite/JSON vector storage.
VECTOR_STORE=json
RETRIEVAL_MODE=hybrid
EMBEDDING_PROVIDER=hash
# For provider-backed semantic vectors, use an OpenAI-compatible /embeddings endpoint.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256

# Optional OCR for scanned PDFs and image uploads. Install the Tesseract engine
# and matching language traineddata (eng+hin by default) on the host OS.
OCR_LANGUAGES=eng+hin
TESSERACT_CMD=
OCR_DPI=250
OCR_MIN_CONFIDENCE=60

# For production set DEMO_MODE=false and AUTO_CREATE_SCHEMA=false, then create
# staff accounts interactively with `python -m app.manage_users add-user`.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/aajeevika
# AUTH_COOKIE_SECURE=true
